{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/beta", "destination": "/beta/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/beta/", "destination": "https://tamoto-main.vercel.app/beta/" },
    { "source": "/beta/:path*", "destination": "https://tamoto-main.vercel.app/beta/:path*" }
  ]
}
