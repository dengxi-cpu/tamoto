{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/beta", "destination": "/beta/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/manifest-beta.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/beta",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/beta/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/beta/" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/legacy?endpoint=auth" },
    { "source": "/api/sync", "destination": "/api/legacy?endpoint=sync" },
    { "source": "/api/vision", "destination": "/api/legacy?endpoint=vision" },
    { "source": "/api/events", "destination": "/api/legacy?endpoint=events" },
    { "source": "/beta/api/events", "destination": "/api/legacy?endpoint=events" },
    { "source": "/beta/api/companion-logs", "destination": "/api/companion-logs" },
    { "source": "/beta/", "destination": "/api/vision-health?serve=beta" },
    { "source": "/beta/:path*", "destination": "/:path*" }
  ]
}
